# --- Shared "brain" ---
ANTHROPIC_API_KEY=
MODERATOR_MODEL=claude-sonnet-5

# Which guide to run — one of: sample, biopharma_v1, biopharma_v2
# (see common/guides/). Defaults to biopharma_v1 if unset.
INTERVIEW_GUIDE=biopharma_v1

# --- Pipeline A: ElevenLabs Conversational AI Agent (Claude as its native LLM) ---
# An ElevenLabs Agent handles ASR + turn-taking + TTS as one hosted loop;
# Claude is selected natively via MODERATOR_MODEL above.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# eleven_v3_conversational is ElevenLabs' most expressive real-time model
# for Conversational AI agents (~280ms latency). Plain "eleven_v3" is NOT
# usable here -- it's a non-realtime model. Drop to eleven_flash_v2_5 if
# latency matters more than expressiveness for what you're testing.
ELEVENLABS_TTS_MODEL_ID=eleven_v3_conversational

# --- Archived (GPT-Live-1, retired -- see archive/gpt_live/) ---
# OPENAI_API_KEY, GPT_LIVE_MODEL, GPT_LIVE_VOICE, GPT_LIVE_PROACTIVE_OPENING,
# GPT_LIVE_STALL_SECONDS, RESPONDENT_MODEL, RESPONDENT_PERSONA,
# ELEVENLABS_RESPONDENT_VOICE_ID, PLAYGROUND_WS_PORT, MODERATOR_BACKEND,
# MODERATOR_MODEL_OPENAI were all only used by archived code -- see
# archive/gpt_live/ if you need to run something from there again.
