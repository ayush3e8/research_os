# --- Shared "brain" ---
ANTHROPIC_API_KEY=
MODERATOR_MODEL=claude-sonnet-5

# Which LLM authors the moderator's questions: anthropic (default) or
# openai. Try "openai" to test whether GPT-Live's client delegation
# behaves differently when the backend it hands off to is also OpenAI's.
# Reuses OPENAI_API_KEY below when set to openai.
MODERATOR_BACKEND=anthropic
MODERATOR_MODEL_OPENAI=gpt-5.6-terra

# Which guide to run — one of: sample, biopharma_v1, biopharma_v2
# (see common/guides/). Defaults to biopharma_v1 if unset.
INTERVIEW_GUIDE=biopharma_v1

# --- Pipeline A: ElevenLabs Conversational AI Agent (Claude as its native LLM) ---
# An ElevenLabs Agent handles ASR + turn-taking + TTS as one hosted loop;
# Claude is selected natively via MODERATOR_MODEL above (e.g. "claude-sonnet-5"),
# not called separately by us the way GPT-Live's client delegation works.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# eleven_v3_conversational is ElevenLabs' most expressive real-time model
# for Conversational AI agents (~280ms latency) -- used for both the
# Pipeline A moderator agent and the playground's respondent agent below.
# Plain "eleven_v3" is NOT usable here -- it's a non-realtime model. Drop
# to eleven_flash_v2_5 if latency matters more than expressiveness for
# what you're testing.
ELEVENLABS_TTS_MODEL_ID=eleven_v3_conversational
OPENAI_API_KEY=

# --- Pipeline B: GPT-Live-1 ---
# Reuses OPENAI_API_KEY above.
GPT_LIVE_MODEL=gpt-live-1
GPT_LIVE_VOICE=marin
# Set to "false" to disable the proactive opening line and wait for the
# participant to speak first instead — a diagnostic toggle, see run.py.
GPT_LIVE_PROACTIVE_OPENING=true

# Seconds without a delegation (while the participant has said something)
# before we nudge GPT-Live via session.instructions.append to delegate
# instead of backchanneling/self-prompting. See common/gpt_live_protocol.py.
GPT_LIVE_STALL_SECONDS=15

# --- Playground: GPT-Live vs. ElevenLabs Agent respondent ---
# The respondent is now an ElevenLabs Agent too (Claude natively selected
# via RESPONDENT_MODEL), bridged to GPT-Live's audio in real time. Needs
# its own voice, distinct from the moderator's above.
ELEVENLABS_RESPONDENT_VOICE_ID=
RESPONDENT_MODEL=claude-sonnet-5
PLAYGROUND_WS_PORT=8765
