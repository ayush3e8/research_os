# --- Required for every architecture (native-LLM or custom-LLM) ---
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# --- Postgres (Neon, via Vercel's native integration): added automatically
# when you attach a Postgres database to this project from the Vercel
# dashboard (Storage tab -> Create Database -> Postgres/Neon). Vercel sets
# DATABASE_URL (and, for legacy compatibility, POSTGRES_URL too) -- either
# works, db/index.ts checks both. Locally, paste the connection string
# Vercel gives you.
DATABASE_URL=

# --- Custom-LLM webhook auth: ElevenLabs sends this back as a Bearer token
# on every request to our /api/architectures/*/chat/completions routes.
# Generate any random string (e.g. `openssl rand -hex 32`) and put the same
# value in the ElevenLabs agent's Custom LLM "API key" field.
CUSTOM_LLM_WEBHOOK_SECRET=

# --- Which interview guide to run (see lib/guide.ts): "everyday" (default)
# is a simple, personal topic (grocery shopping / meal planning) anyone can
# be genuinely interviewed on, for testing whether a moderator feels good
# without acting out a persona. "biopharma" is the real target-domain topic.
# Changing this only affects new agents -- delete the cached
# architecture_agents row (see scripts/diagnose.js) to force re-provisioning
# with the new opening line after switching.
GUIDE=everyday
